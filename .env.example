# Port the HTTP server listens on (1-65535)
PORT=3000

# Optional. If unset/empty, an in-memory cache is used instead.
# Example: redis://localhost:6379
# Example (TLS): rediss://user:password@host:6380
REDIS_URL=

# Cache TTLs, in seconds
FEED_CACHE_TTL=300
SEARCH_CACHE_TTL=300

# Upstream (MyInstants) request timeout, in milliseconds
REQUEST_TIMEOUT=5000
